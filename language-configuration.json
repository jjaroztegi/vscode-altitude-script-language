{
    "comments": {
        "blockComment": ["comment {", "}"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "colorizedBracketPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] },
        { "open": "$(", "close": ")", "notIn": ["comment"] },
        { "open": "<\"", "close": "\">", "notIn": ["string", "comment"] }
    ],
    "autoCloseBefore": ";:.,=}])>` \n\t",
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "wordPattern": "(@?[\p{L}_][\p{L}\p{N}_]*)|(-?\d*\.\d+)|(-?\d+)",
    "indentationRules": {
        "increaseIndentPattern": "^.*\{[^}\"']*$",
        "decreaseIndentPattern": "^\s*\}"
    },
    "onEnterRules": [
        {
            "beforeText": "^\s*.*\{\s*$",
            "afterText": "^\s*\}",
            "action": { "indent": "indentOutdent" }
        },
        {
            "beforeText": "^\s*.*\{\s*$",
            "action": { "indent": "indent" }
        }
    ]
}
