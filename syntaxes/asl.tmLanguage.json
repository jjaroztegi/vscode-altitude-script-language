{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Altitude ASL",
    "scopeName": "source.altitude-asl",
    "patterns": [
        {
            "include": "#trailer"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#statements"
        }
    ],
    "repository": {
        "trailer": {
            "comment": "Script Developer appends XML metadata after the last declaration.",
            "begin": "^(?=<\\?xml)",
            "end": "(?!\\G)\\z",
            "name": "meta.embedded.block.xml",
            "patterns": [
                {
                    "include": "text.xml"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.altitude-asl",
                    "begin": "\\b(comment)\\s*(\\{)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.other.comment.altitude-asl"
                        },
                        "2": {
                            "name": "punctuation.definition.comment.begin.altitude-asl"
                        }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.end.altitude-asl"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comment-braces"
                        }
                    ]
                },
                {
                    "name": "comment.line.altitude-asl",
                    "match": "\\b(comment)\\s+(\"[^\"]*\"|'(?:[^'\\\\]|\\\\.)*')",
                    "captures": {
                        "1": {
                            "name": "keyword.other.comment.altitude-asl"
                        }
                    }
                }
            ]
        },
        "comment-braces": {
            "begin": "\\{",
            "end": "\\}",
            "patterns": [
                {
                    "include": "#comment-braces"
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "match": "\\b(private\\s+)?(node|block)\\s+(\"[^\"]*\"|'[^']*')",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.altitude-asl"
                        },
                        "2": {
                            "name": "storage.type.node.altitude-asl"
                        },
                        "3": {
                            "name": "entity.name.type.node.altitude-asl"
                        }
                    }
                },
                {
                    "match": "\\b(private\\s+)?(external\\s+(?:session\\s+)?(?:stdcall\\s+|cdecl\\s+)?)?(subroutine|function)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.altitude-asl"
                        },
                        "2": {
                            "name": "storage.modifier.altitude-asl"
                        },
                        "3": {
                            "name": "storage.type.function.altitude-asl"
                        },
                        "4": {
                            "name": "entity.name.function.altitude-asl"
                        }
                    }
                },
                {
                    "match": "\\b(on)\\s+(event|error|progress)\\s+((?:[\\p{L}_][\\p{L}\\p{N}_]*)(?:[ \\t]+[\\p{L}_][\\p{L}\\p{N}_]*)*)",
                    "captures": {
                        "1": {
                            "name": "keyword.other.handler.altitude-asl"
                        },
                        "2": {
                            "name": "keyword.other.handler.altitude-asl"
                        },
                        "3": {
                            "name": "entity.name.function.event.altitude-asl"
                        }
                    }
                },
                {
                    "match": "\\b(on)\\s+(start|end|load|unload|first\\s+enter|enter|exit)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.other.handler.altitude-asl"
                        },
                        "2": {
                            "name": "keyword.other.handler.altitude-asl"
                        }
                    }
                },
                {
                    "match": "\\b(on)\\s+((?:[a-z]+\\s+)*?[a-z]+)(?=\\s*(?:\\(|\\{|commit\\b|rollback\\b|ignore\\b|$))",
                    "captures": {
                        "1": {
                            "name": "keyword.other.handler.altitude-asl"
                        },
                        "2": {
                            "name": "entity.name.function.event.altitude-asl"
                        }
                    }
                },
                {
                    "match": "\\b(import)\\s+(<\"[^\"]*\">|\"[^\"]*\")(?:\\s+(into\\s+namespace)\\s+([\\p{L}_][\\p{L}\\p{N}_]*))?",
                    "captures": {
                        "1": {
                            "name": "keyword.control.import.altitude-asl"
                        },
                        "2": {
                            "name": "string.quoted.other.path.altitude-asl"
                        },
                        "3": {
                            "name": "keyword.control.import.altitude-asl"
                        },
                        "4": {
                            "name": "entity.name.namespace.altitude-asl"
                        }
                    }
                },
                {
                    "name": "storage.type.section.altitude-asl",
                    "match": "\\b(?:modules|dependencies|constants|types|variables|parameters|cursors|using\\s+namespaces|campaign\\s+record|contact\\s+record|workflow\\s+record|transferred\\s+record|outcome\\s+record|contact\\s+profile\\s+extensions|audio)(?=\\s*\\{)"
                },
                {
                    "name": "keyword.other.declaration.altitude-asl",
                    "match": "\\b(?:version|file\\s+version|default\\s+font|default\\s+master|without\\s+master|master|exit\\s+point|node\\s+loop|function\\s+key|flow\\s+view|year\\s+completion|(?:date|time|datetime|number)\\s+format|exclude\\s+from\\s+zip|in\\s+file|in\\s+url|of\\s+type|dll\\s+(?:native|managed)|web\\s+service|private|ref|out|record|enumeration|defined\\s+in|array(?:\\s+\\[[^\\]]*\\])?\\s+of|sql\\s+for|file\\s+for|memory\\s+for|enumeration\\s+for|system\\s+for|delimiter|columns|filter|order\\s+by|input|required|check|on\\s+error\\s+show|named|compiler|export\\s+ordinal|as)\\b"
                },
                {
                    "name": "entity.name.tag.element.altitude-asl",
                    "match": "\\b(?:radio\\s+button|email\\s+editor|chat\\s+control|static\\s+text|push\\s+button|text\\s+button|web\\s+browser|static\\s+box|container|check\\s+box|combo\\s+box|input|table|group|menu)\\b(?=\\s*(?:\"|'|\\{|for\\b))"
                },
                {
                    "include": "#statements"
                }
            ]
        },
        "statements": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#strings"
                },
                {
                    "name": "keyword.control.altitude-asl",
                    "match": "\\b(?:if|then|else|case|when|do|default|while|repeat|until|for|to|step|break\\s+loop|return\\s+node|return|goto\\s+node|call\\s+node|back\\s+node|exit\\s+through|call)\\b"
                },
                {
                    "name": "keyword.other.var.altitude-asl",
                    "match": "\\b(?:var|const)\\b"
                },
                {
                    "name": "keyword.operator.word.altitude-asl",
                    "match": "\\b(?:and|or|xor|not|new)\\b"
                },
                {
                    "name": "constant.language.altitude-asl",
                    "match": "\\b(?:true|false|null|NULL)\\b"
                },
                {
                    "name": "storage.type.primitive.altitude-asl",
                    "match": "\\b(?:boolean|number|text|date|time|datetime|bytestream)\\b(?!\\s*\\()"
                },
                {
                    "name": "keyword.other.action.altitude-asl",
                    "match": "\\b(?:download\\s+instant\\s+messaging\\s+transcript\\s+with\\s+id|load\\s+workflow\\s+contact\\s+profile\\s+with\\s+unique\\s+id|reschedule\\s+loaded\\s+contact\\s+with\\s+failed\\s+reason|load\\s+contact\\s+with\\s+contact\\s+profile\\s+unique\\s+id|set\\s+current\\s+contact\\s+profile\\s+extension\\s+to|upload\\s+new\\s+revision\\s+for\\s+document\\s+with\\s+id|reschedule\\s+contact\\s+with\\s+failed\\s+reason|update\\s+contact\\s+profile\\s+with\\s+unique\\s+id|set\\s+default\\s+lexicon\\s+file\\s+to\\s+content|get\\s+contact\\s+profile\\s+with\\s+unique\\s+id|create\\s+outcome\\s+for\\s+script\\s+session|pick\\s+up\\s+email\\s+interaction\\s+with\\s+id|cancel\\s+phone\\s+supervision\\s+request|blind\\s+transfer\\s+instant\\s+messaging|divert\\s+instant\\s+messaging\\s+to\\s+dnis|media\\s+panel\\s+chat\\s+save\\s+transcript|manual\\s+blind\\s+transfer\\s+phone\\s+to|send\\s+outbound\\s+template\\s+message|upload\\s+new\\s+document\\s+with\\s+name|add\\s+to\\s+do\\s+not\\s+call\\s+list\\s+phone|media\\s+panel\\s+chat\\s+send\\s+message|pick\\s+up\\s+workflow\\s+task\\s+with\\s+id|save\\s+current\\s+contact\\s+profile|send\\s+knowledge\\s+base\\s+document|disconnect\\s+instant\\s+messaging|conference\\s+instant\\s+messaging|start\\s+instant\\s+messaging\\s+with|media\\s+panel\\s+chat\\s+insert\\s+text|set\\s+default\\s+grammar\\s+for\\s+type|load\\s+contact\\s+selected\\s+from|retrieve\\s+instant\\s+messaging|transfer\\s+instant\\s+messaging|start\\s+outbound\\s+interaction|call\\s+master\\s+event\\s+handler|reschedule\\s+loaded\\s+contact|disable\\s+contact\\s+with\\s+code|restart\\s+contact\\s+with\\s+code|download\\s+document\\s+with\\s+id|set\\s+soft\\s+phone\\s+microphone|request\\s+phone\\s+supervision|divert\\s+phone\\s+to\\s+voicemail|set\\s+current\\s+directory\\s+to|set\\s+soft\\s+phone\\s+volume\\s+to|answer\\s+instant\\s+messaging|extend\\s+instant\\s+messaging|end\\s+workflow\\s+reservation|open\\s+web\\s+browser\\s+window|set\\s+default\\s+language\\s+to|blind\\s+transfer\\s+phone\\s+to|clear\\s+instant\\s+messaging|load\\s+contact\\s+with\\s+code|reserve\\s+loaded\\s+contact|set\\s+business\\s+status\\s+to|add\\s+to\\s+outcomes\\s+values|update\\s+outcome\\s+with\\s+id|remove\\s+outcome\\s+with\\s+id|start\\s+workflow\\s+process|set\\s+next\\s+workflow\\s+task|trigger\\s+workflow\\s+event|create\\s+contact\\s+profile|media\\s+panel\\s+chat\\s+clear|stop\\s+asynchronous\\s+play|handle\\s+pending\\s+events|bring\\s+window\\s+to\\s+front|start\\s+error\\s+reporting|set\\s+workflow\\s+notes\\s+to|end\\s+phone\\s+reservation|call\\s+supervisor\\s+phone|end\\s+email\\s+reservation|forward\\s+email\\s+with\\s+id|send\\s+outbound\\s+message|speech\\s+recognize\\s+into|stop\\s+error\\s+reporting|blind\\s+transfer\\s+email|send\\s+instant\\s+message|set\\s+agent\\s+not\\s+ready|kill\\s+timer\\s+with\\s+id|system\\s+select\\s+from|bring\\s+tab\\s+to\\s+front|start\\s+record\\s+phone|system\\s+count\\s+from|stop\\s+record\\s+phone|load\\s+grammar\\s+name|open\\s+message\\s+box|schedule\\s+contact|set\\s+time\\s+zone\\s+to|conference\\s+phone|record\\s+into\\s+file|set\\s+timer\\s+event|set\\s+agent\\s+ready|generic\\s+service|divert\\s+phone\\s+to|save\\s+attachment|answer\\s+workflow|get\\s+digits\\s+into|discard\\s+script|restart\\s+script|unload\\s+contact|create\\s+contact|update\\s+current|retrieve\\s+phone|transfer\\s+phone|trigger\\s+event|hang\\s+up\\s+phone|send\\s+email\\s+to|abort\\s+script|exit\\s+through|close\\s+window|set\\s+timer\\s+to|close\\s+cursor|fetch\\s+cursor|answer\\s+phone|extend\\s+phone|answer\\s+email|clear\\s+digits|clear\\s+error|return\\s+node|open\\s+window|open\\s+cursor|sql\\s+execute|get\\s+current|clear\\s+phone|clear\\s+email|send\\s+digits|end\\s+script|break\\s+loop|kill\\s+timer|sql\\s+select|hold\\s+phone|dial\\s+phone|play\\s+music|input\\s+into|write\\s+log|back\\s+node|set\\s+timer|close\\s+tab|send\\s+data|open\\s+tab|message|enqueue|dequeue|suspend|remove|choose|resume|write|close|bring|reply|open|play|dim|add|set)\\b"
                },
                {
                    "match": "\\b(graphical\\s+element|input|container|web\\s+browser|email\\s+editor|chat\\s+control|menu|table)\\s+(?=['\"]|[\\p{L}_])(?!for\\b|\\{)",
                    "captures": {
                        "1": {
                            "name": "entity.name.tag.element.altitude-asl"
                        }
                    }
                },
                {
                    "name": "keyword.other.modifier.altitude-asl",
                    "match": "\\b(?:commit|rollback|ignore|overlay|caption|arguments|into|variable|match\\s+by\\s+name|absolute|relative|at|size|with|trigger\\s+event|on\\s+close|values|attribute)\\b"
                },
                {
                    "include": "#expressions"
                }
            ]
        },
        "expressions": {
            "patterns": [
                {
                    "include": "#strings"
                },
                {
                    "name": "variable.language.attribute.altitude-asl",
                    "match": "@[\\p{L}_][\\p{L}\\p{N}_]*"
                },
                {
                    "name": "constant.numeric.altitude-asl",
                    "match": "(?<![\\p{L}\\p{N}_])(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?![\\p{L}\\p{N}_])"
                },
                {
                    "name": "support.class.enum.altitude-asl",
                    "match": "\\b(?:InteractionTerminationState|RecordingTerminationReason|ScriptExecutionErrorCode|AudioRecordResultType|ContactBusinessStatus|InstantMessagingError|InstantMessagingState|MessageBoxButtonStyle|PlayTerminationReason|ScheduledContactState|WorkflowPriorityClass|DequeueRequestReason|InteractionPartyType|RecordingStartReason|ServerCOMMSErrorCode|WorkflowProcessState|ContactFailedReason|DequeuedEventReason|MessageBoxIconStyle|ServerDOCMErrorCode|SqlContainsOperator|ServerPBXErrorCode|DatabaseErrorCode|InteractionOrigin|RestartScriptMode|ScriptStartReason|ServerAMErrorCode|ServerSSErrorCode|AnnouncementType|BusinessDataType|InteractionState|MessageBoxButton|QueuedEmailState|WorkflowTaskType|AgentReadyError|PendingWorkType|SupervisionMode|AgentErrorCode|AudioErrorCode|BusinessStatus|FileAccessMode|SentEmailState|CampaignState|FileShareMode|WorkflowState|SeekPosition|SystemCursor|SystemFolder|TextEncoding|TrimPosition|AddressType|EmailState|PhoneError|PhoneState|TargetType|AgentType|ErrorType|MediaType|DataType|Gender)(?=::)"
                },
                {
                    "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)(::)",
                    "captures": {
                        "1": {
                            "name": "entity.name.namespace.altitude-asl"
                        },
                        "2": {
                            "name": "punctuation.separator.namespace.altitude-asl"
                        }
                    }
                },
                {
                    "name": "support.function.builtin.altitude-asl",
                    "match": "\\b(?:contact_profile_extension_schema|campaign_agents_media_info|interaction_history_detail|session_outcomes_history|skill_profile_media_info|available_agents_info|selected_cursor_line|phone_schedule_rules|workflow_definitions|campaign_agents_info|text_replace_regex|text_to_bytestream|bytestream_to_text|local_to_time_zone|time_zone_to_local|build_sql_contains|folder_system_path|custom_call_states|skill_profile_info|document_revisions|linked_exit_point|soft_phone_volume|last_called_agent|current_email_id|text_find_regex|file_split_path|file_write_line|GetDayTypeNames|activity_schema|campaign_schema|number_ceiling|full_node_name|datetime_array|file_make_path|file_read_line|outbound_rules|skill_profiles|queue_position|text_to_upper|text_to_lower|boolean_array|file_datetime|skill_profile|email_message|campaign_info|document_info|number_floor|number_round|text_extract|text_replace|number_array|tmp_filename|file_browser|text_length|text_append|file_create|file_delete|file_exists|number_hex|number_mod|text_split|text_array|date_array|time_array|file_close|file_write|time_zones|agent_info|text_find|text_trim|file_open|file_seek|file_read|file_copy|rgb_color|campaigns|ani_lists|datetime|week_day|nmonths|ordinal|format|minute|second|nyears|lookup|agents|medias|today|month|whole|spell|date|time|year|hour|size|now|day|if)(?=\\s*\\()"
                },
                {
                    "name": "variable.language.business.altitude-asl",
                    "match": "\\b(?:campaign|contact|workflow|transferred|outcomes|contact_profile)\\b(?=\\s*[.\\[])"
                },
                {
                    "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.call.altitude-asl"
                        }
                    }
                },
                {
                    "name": "keyword.operator.assignment.altitude-asl",
                    "match": ":="
                },
                {
                    "name": "keyword.operator.comparison.altitude-asl",
                    "match": "<>|<=|>=|=|<|>"
                },
                {
                    "name": "keyword.operator.arithmetic.altitude-asl",
                    "match": "[+\\-*/]"
                },
                {
                    "name": "punctuation.separator.altitude-asl",
                    "match": "[,?]"
                },
                {
                    "name": "punctuation.accessor.altitude-asl",
                    "match": "\\."
                },
                {
                    "begin": "\\(",
                    "end": "\\)",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.parenthesis.begin.altitude-asl"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.parenthesis.end.altitude-asl"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.other.path.altitude-asl",
                    "begin": "<\"",
                    "end": "\">",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.altitude-asl"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.altitude-asl"
                        }
                    }
                },
                {
                    "name": "string.quoted.double.altitude-asl",
                    "begin": "\"",
                    "end": "\"|$",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.altitude-asl"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.altitude-asl"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.altitude-asl",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "comment": "Text that starts with a SQL verb: highlight SQL keywords and interpolations.",
                    "name": "string.quoted.single.sql.altitude-asl",
                    "begin": "'(?=\\s*(?i:select|insert|update|delete|exec|execute|with|merge)\\b)",
                    "end": "'|$",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.altitude-asl"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.altitude-asl"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#fib-content"
                        },
                        {
                            "include": "#sql-keywords"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.altitude-asl",
                    "begin": "'",
                    "end": "'|$",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.altitude-asl"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.altitude-asl"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#fib-content"
                        }
                    ]
                }
            ]
        },
        "fib-content": {
            "patterns": [
                {
                    "name": "constant.character.escape.altitude-asl",
                    "match": "\\\\."
                },
                {
                    "name": "meta.interpolation.altitude-asl",
                    "begin": "([$%])(\\()",
                    "end": "\\)",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.section.interpolation.begin.altitude-asl"
                        },
                        "2": {
                            "name": "punctuation.section.interpolation.begin.altitude-asl"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.section.interpolation.end.altitude-asl"
                        }
                    },
                    "contentName": "source.altitude-asl.embedded",
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "sql-keywords": {
            "patterns": [
                {
                    "name": "keyword.other.sql.altitude-asl",
                    "match": "(?i)\\b(?:select|from|where|insert|into|values|update|set|delete|join|inner|left|right|outer|on|and|or|not|in|is|null|like|between|group|by|order|having|distinct|top|as|case|when|then|else|end|exec|execute|union|all|exists|with|nolock|asc|desc|count|sum|avg|min|max|convert|cast|isnull|coalesce|getdate)\\b"
                }
            ]
        }
    }
}
