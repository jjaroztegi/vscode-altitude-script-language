{
    "name": "vscode-altitude-script-language",
    "displayName": "Altitude ASL Language Support",
    "description": "Syntax highlighting, IntelliSense, diagnostics, navigation, formatting, and compiler validation for Altitude Script Language (Altitude 8.7).",
    "version": "1.0.0",
    "publisher": "jjaroztegi",
    "main": "./dist/extension.js",
    "galleryBanner": {
        "color": "#1b1f23",
        "theme": "dark"
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "check-types": "tsc --noEmit",
        "compile": "npm run check-types && node esbuild.js",
        "watch": "node esbuild.js --watch",
        "package": "npm run check-types && node esbuild.js --production",
        "test": "esbuild test/parseCampaigns.ts --bundle --platform=node --outfile=dist-test/parseCampaigns.js --alias:vscode=./test/vscodeStub.ts && node dist-test/parseCampaigns.js",
        "vsix": "vsce package",
        "publish:ovsx": "npx ovsx publish",
        "publish:vscode": "vsce publish"
    },
    "devDependencies": {
        "@types/node": "^24.12.0",
        "@types/vscode": "~1.100.0",
        "@vscode/vsce": "^3.7.1",
        "esbuild": "^0.28.1",
        "typescript": "^5.9.3"
    },
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Programming Languages",
        "Linters",
        "Formatters"
    ],
    "keywords": [
        "altitude",
        "asl",
        "ags",
        "irs",
        "script developer",
        "contact center",
        "formatter",
        "diagnostics",
        "intellisense",
        "syntax highlighting"
    ],
    "icon": "images/logo_128.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/jjaroztegi/vscode-altitude-script-language.git"
    },
    "homepage": "https://github.com/jjaroztegi/vscode-altitude-script-language",
    "bugs": {
        "url": "https://github.com/jjaroztegi/vscode-altitude-script-language/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "contributes": {
        "configurationDefaults": {
            "[asl]": {
                "files.encoding": "utf8bom",
                "files.eol": "\r\n",
                "editor.insertSpaces": false,
                "editor.detectIndentation": false,
                "editor.tabSize": 4
            }
        },
        "commands": [
            {
                "command": "altitudeScriptLanguage.validateWithCompiler",
                "title": "Altitude Script: Validate Current File"
            }
        ],
        "languages": [
            {
                "id": "asl",
                "aliases": [
                    "Altitude Script",
                    "asl"
                ],
                "extensions": [
                    ".ags",
                    ".irs",
                    ".gem",
                    ".agm",
                    ".irm"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "asl",
                "scopeName": "source.altitude",
                "path": "./syntaxes/asl.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "asl",
                "path": "./snippets/asl.json"
            }
        ],
        "configuration": {
            "title": "Altitude Script Language",
            "properties": {
                "altitudeScriptLanguage.format.indentSize": {
                    "type": "integer",
                    "default": 4,
                    "minimum": 1,
                    "maximum": 8,
                    "description": "Indent size used by the ASL document formatter when the file does not already establish a consistent indentation style."
                },
                "altitudeScriptLanguage.diagnostics.undefinedReferences": {
                    "type": "boolean",
                    "default": true,
                    "description": "Report unresolved explicit node, variable-target, and cursor references recognized by the ASL analyzer."
                },
                "altitudeScriptLanguage.diagnostics.controlProperties": {
                    "type": "boolean",
                    "default": true,
                    "description": "Validate ASL control properties against the documented Altitude control schemas."
                },
                "altitudeScriptLanguage.compiler.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run Script Developer compiler (ec.exe) validation for .ags and .irs files when an Altitude Script Developer installation is found."
                },
                "altitudeScriptLanguage.compiler.runOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run compiler validation after save when validation is enabled."
                },
                "altitudeScriptLanguage.compiler.installRoot": {
                    "type": "string",
                    "default": "",
                    "description": "Optional Altitude Script Developer install root (the folder containing bin\\ec.exe). Leave empty to auto-detect common install locations."
                },
                "altitudeScriptLanguage.compiler.timeoutMs": {
                    "type": "integer",
                    "default": 60000,
                    "minimum": 5000,
                    "maximum": 300000,
                    "description": "Timeout in milliseconds for compiler validation runs."
                }
            }
        }
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    }
}
