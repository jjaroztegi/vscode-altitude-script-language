{
    "name": "vscode-altitude-script-language",
    "displayName": "Altitude Script Language",
    "description": "Syntax highlighting, IntelliSense, diagnostics, navigation, formatting, and validation for Altitude Script Language.",
    "version": "0.1.0",
    "publisher": "jjaroztegi",
    "main": "./out/extension.js",
    "galleryBanner": {
        "color": "#1b1f23",
        "theme": "dark"
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "npx vsce package",
        "publish:ovsx": "npx ovsx publish",
        "publish:vscode": "npx vsce publish"
    },
    "devDependencies": {
        "@types/node": "^24.12.0",
        "@types/vscode": "^1.57.0",
        "@vscode/vsce": "^3.7.1",
        "typescript": "^5.9.3"
    },
    "engines": {
        "vscode": "^1.57.0"
    },
    "categories": [
        "Programming Languages",
        "Linters",
        "Formatters"
    ],
    "keywords": [
        "altitude",
        "asl",
        "ags",
        "irs",
        "script developer",
        "contact center",
        "formatter",
        "diagnostics",
        "intellisense",
        "syntax highlighting"
    ],
    "icon": "images/logo_128.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/jjaroztegi/vscode-altitude-script-language.git"
    },
    "homepage": "https://github.com/jjaroztegi/vscode-altitude-script-language",
    "bugs": {
        "url": "https://github.com/jjaroztegi/vscode-altitude-script-language/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "activationEvents": [
        "onLanguage:asl",
        "onCommand:altitudeScriptLanguage.validateWithCompiler"
    ],
    "contributes": {
        "commands": [
            {
                "command": "altitudeScriptLanguage.validateWithCompiler",
                "title": "Altitude Script: Validate Current File"
            }
        ],
        "languages": [{
            "id": "asl",
            "aliases": ["Altitude Script", "asl"],
            "extensions": [".ags",".irs",".gem",".agm",".irm",".bak"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "asl",
            "scopeName": "source.altitude",
            "path": "./syntaxes/asl.tmLanguage.json"
        }],
        "snippets": [{
            "language": "asl",
            "path": "./snippets/asl.json"
        }],
        "configuration": {
            "title": "Altitude Script Language",
            "properties": {
                "altitudeScriptLanguage.format.indentSize": {
                    "type": "integer",
                    "default": 4,
                    "minimum": 1,
                    "maximum": 8,
                    "description": "Indent size used by the ASL document formatter when the file does not already establish a consistent indentation style."
                },
                "altitudeScriptLanguage.diagnostics.undefinedReferences": {
                    "type": "boolean",
                    "default": true,
                    "description": "Report unresolved explicit node, variable-target, and cursor references recognized by the ASL analyzer."
                },
                "altitudeScriptLanguage.diagnostics.controlProperties": {
                    "type": "boolean",
                    "default": true,
                    "description": "Validate ASL control properties against the documented Altitude control schemas."
                },
                "altitudeScriptLanguage.compiler.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable Script Developer compiler validation for .ags and .irs files."
                },
                "altitudeScriptLanguage.compiler.runOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run Script Developer compiler validation after save when validation is enabled."
                },
                "altitudeScriptLanguage.compiler.runOnType": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run Script Developer compiler validation after edits using a debounce interval."
                },
                "altitudeScriptLanguage.compiler.debounceMs": {
                    "type": "integer",
                    "default": 1200,
                    "minimum": 200,
                    "maximum": 10000,
                    "description": "Debounce interval in milliseconds for on-type Script Developer compiler validation."
                },
                "altitudeScriptLanguage.compiler.installRoot": {
                    "type": "string",
                    "default": "",
                    "description": "Optional Altitude Script Developer install root. Leave empty to auto-detect common install locations."
                },
                "altitudeScriptLanguage.compiler.timeoutMs": {
                    "type": "integer",
                    "default": 20000,
                    "minimum": 1000,
                    "maximum": 120000,
                    "description": "Timeout in milliseconds for Script Developer validation runs."
                }
            }
        }
    }
}
