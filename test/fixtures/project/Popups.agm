version "8.7"
file version 1, 0
comment {Reusable popups. Popups are overlays: the caller handles the answer in an event.}

variables {
	gMessage: text
}

subroutine ShowError(message: text)
{
	open window 'Popups::INFO' size 390, 160 caption 'Error' overlay arguments message
}

subroutine ShowInfo(message: text)
{
	open window 'Popups::INFO' size 390, 160 caption 'Information' overlay arguments message
}

node "QUESTION" {
	id 90
	parameters {
		Message: text
		ref Answer: number
	}
	static text {
		size 350,60 at 20,20
		label '$(Message)' {}
	}
	push button "btnYes" {
		size 80,30 at 100,110
		label "Yes" {}
		on click commit {
			Answer := 1
			close window
		}
	}
	push button "btnNo" {
		size 80,30 at 200,110
		label "No" {}
		on click commit {
			Answer := 0
			close window
		}
	}
	on first enter {}
	on enter {}
	on exit {}
}

node "INFO" {
	id 91
	parameters {
		Message: text
	}
	static text {
		size 350,60 at 20,20
		label '$(Message)' {}
	}
	push button "btnOk" {
		size 80,30 at 150,110
		label "OK" {}
		on click commit {
			close window
		}
	}
	on first enter {}
	on enter {}
	on exit {}
}
